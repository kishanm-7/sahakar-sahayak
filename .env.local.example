# Copy this file to .env.local and paste your real key in.
# .env.local is git-ignored so the key never gets committed.
OPENAI_API_KEY=

# Optional overrides (sensible defaults are used if you leave these out)
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=alloy
# OPENAI_STT_MODEL=whisper-1

# RAG Vector Store Notes:
# The RAG vector store is committed to git as `data/vectors.json.gz` (compressed ~6.5MB)
# so it automatically deploys to Vercel without requiring extra cloud storage keys.

# Supabase Configuration for Grievances
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

